{
  "id": "music3-t2a",
  "variant": "int8",
  "minVramGb": 11,
  "label": "MiniMax Music 3 (music, best)",
  "card": "audio",
  "needs": [],
  "output": "audio",
  "knobs": "music3",
  "defaults": { "duration": 30, "lyrics": "[instrumental]" },
  "bindings": {
    "prompt": ["@positive", "caption"],
    "lyrics": ["@positive", "lyrics"],
    "seed": [["@positive", "seed"], ["@sampler", "seed"]],
    "duration": ["@positive", "max_duration"]
  },
  "graph": {
    "1": { "class_type": "UNETLoader", "_meta": { "title": "@model" }, "inputs": { "unet_name": "minimax_music3_dit_int8_convrot.safetensors", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "_meta": { "title": "@clip" }, "inputs": { "clip_name": "minimax_music3_text_encoder_pruned_int8_convrot.safetensors", "type": "minimax", "device": "default" } },
    "3": { "class_type": "VAELoader", "_meta": { "title": "@vae" }, "inputs": { "vae_name": "minimax_music3_dav.safetensors" } },
    "4": { "class_type": "MiniMaxMusic3TextEncode", "_meta": { "title": "@positive" }, "inputs": { "clip": ["2", 0], "caption": "", "lyrics": "[instrumental]", "seed": 0, "max_duration": 30, "cfg_scale": 1.7, "top_k": 50 } },
    "5": { "class_type": "ConditioningZeroOut", "_meta": { "title": "@negative" }, "inputs": { "conditioning": ["4", 0] } },
    "6": { "class_type": "EmptyMiniMaxMusic3LatentAudio", "_meta": { "title": "@latent" }, "inputs": { "seconds": ["4", 1], "batch_size": 1 } },
    "7": { "class_type": "KSampler", "_meta": { "title": "@sampler" }, "inputs": { "model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0], "seed": 0, "steps": 30, "cfg": 1.7, "sampler_name": "euler", "scheduler": "simple", "denoise": 1 } },
    "8": { "class_type": "VAEDecodeAudioTiled", "_meta": { "title": "@decode" }, "inputs": { "samples": ["7", 0], "vae": ["3", 0], "tile_size": 1536, "overlap": 64 } },
    "9": { "class_type": "SaveAudioAdvanced", "_meta": { "title": "@output" }, "inputs": { "audio": ["8", 0], "filename_prefix": "bloop-studio/audio", "format": "mp3", "format.quality": "V0" } }
  }
}
