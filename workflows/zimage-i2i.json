{
  "id": "zimage-i2i",
  "label": "Z-Image Turbo (from picture)",
  "card": "image",
  "needs": ["reference"],
  "output": "image",
  "defaults": { "width": 1024, "height": 1024, "steps": 8, "strength": 0.65 },
  "bindings": {
    "prompt": ["@positive", "text"],
    "seed": ["@sampler", "seed"],
    "steps": ["@sampler", "steps"],
    "strength": ["@sampler", "denoise"],
    "width": ["@resize", "width"],
    "height": ["@resize", "height"],
    "reference": ["@image", "image"]
  },
  "models": [
    ["diffusion_models", "z_image_turbo_bf16.safetensors"],
    ["text_encoders", "qwen_3_4b.safetensors"],
    ["vae", "ae.safetensors"]
  ],
  "graph": {
    "28": { "class_type": "UNETLoader", "_meta": { "title": "@model" }, "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" } },
    "30": { "class_type": "CLIPLoader", "_meta": { "title": "@clip" }, "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default" } },
    "29": { "class_type": "VAELoader", "_meta": { "title": "@vae" }, "inputs": { "vae_name": "ae.safetensors" } },
    "11": { "class_type": "ModelSamplingAuraFlow", "_meta": { "title": "@shift" }, "inputs": { "model": ["28", 0], "shift": 3 } },
    "27": { "class_type": "CLIPTextEncode", "_meta": { "title": "@positive" }, "inputs": { "clip": ["30", 0], "text": "" } },
    "33": { "class_type": "ConditioningZeroOut", "_meta": { "title": "@negative" }, "inputs": { "conditioning": ["27", 0] } },
    "40": { "class_type": "LoadImage", "_meta": { "title": "@image" }, "inputs": { "image": "" } },
    "41": { "class_type": "ImageScale", "_meta": { "title": "@resize" }, "inputs": { "image": ["40", 0], "upscale_method": "lanczos", "width": 1024, "height": 1024, "crop": "center" } },
    "42": { "class_type": "VAEEncode", "_meta": { "title": "@encode" }, "inputs": { "pixels": ["41", 0], "vae": ["29", 0] } },
    "3": { "class_type": "KSampler", "_meta": { "title": "@sampler" }, "inputs": { "model": ["11", 0], "positive": ["27", 0], "negative": ["33", 0], "latent_image": ["42", 0], "seed": 0, "steps": 8, "cfg": 1, "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 0.65 } },
    "8": { "class_type": "VAEDecode", "_meta": { "title": "@decode" }, "inputs": { "samples": ["3", 0], "vae": ["29", 0] } },
    "9": { "class_type": "SaveImage", "_meta": { "title": "@output" }, "inputs": { "images": ["8", 0], "filename_prefix": "bloop-studio/image" } }
  }
}
