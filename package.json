{
  "name": "bloop-studio",
  "productName": "Bloop Studio",
  "version": "0.1.0",
  "description": "Offline Spaces + Director studio running on a local ComfyUI.",
  "private": true,
  "license": "UNLICENSED",
  "author": "MarketDragon",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "start": "npm run vendor && electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "npm run vendor && node scripts/build-installer.mjs",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "alpinejs": "^3.17.4",
    "edge.js": "^6.5.1",
    "hono": "^4.13.12",
    "htmx.org": "^2.0.11",
    "openai": "^7.25.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ph.marketdragon.bloopstudio",
    "productName": "Bloop Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "public/**",
      "workflows/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloop Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Bloop-Studio-Setup-${version}.${ext}"
    },
    "copyright": "Copyright © MarketDragon"
  }
}
