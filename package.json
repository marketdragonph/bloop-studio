{
  "name": "bloop-studio",
  "productName": "Bloop Studio",
  "version": "0.1.0",
  "description": "Offline Spaces + Director studio running on a local ComfyUI.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "start": "npm run vendor && electron .",
    "test": "node --test tests/",
    "dist": "npm run vendor && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "alpinejs": "^3.17.4",
    "edge.js": "^6.5.1",
    "hono": "^4.13.12",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "studio.bloop.local",
    "productName": "Bloop Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "public/**",
      "workflows/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
