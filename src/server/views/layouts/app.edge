<!doctype html>
<html lang="en" data-theme="{{ currentTheme() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{-- 'unsafe-eval' is required by Alpine's inline expressions (ported from bloop). Only our own
         127.0.0.1 server is ever loaded in this window, and no remote content is allowed. --}}
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self'">
    {{-- 422 = validation errors: swap them in like a success so the form shows what to fix. --}}
    <meta name="htmx-config" content='{"includeIndicatorStyles": false, "responseHandling": [{"code": "204", "swap": false}, {"code": "[23]..", "swap": true}, {"code": "422", "swap": true}, {"code": "[45]..", "swap": false, "error": true}]}'>
    <meta name="csrf-token" content="{{ csrfToken }}">
    <title>{{ title ? `${title} · ${appName}` : appName }}</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    <script src="/assets/vendor/htmx.min.js" defer></script>
    <script type="module" src="/assets/js/app.js"></script>
</head>
<body class="{{ bodyClass ?? '' }}" hx-headers='{"X-CSRF-Token": "{{ csrfToken }}"}' hx-boost="true">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
        <a class="topbar__brand" href="/spaces">Bloop Studio</a>
        <nav class="topbar__nav" aria-label="Main">
            <a href="/spaces" class="topbar__link">{{{ icon('board') }}}<span>Spaces</span></a>
            <a href="/settings" class="topbar__link">{{{ icon('settings') }}}<span>Settings</span></a>
        </nav>
        <div class="topbar__engine" data-engine-light
             hx-get="/engine/status" hx-trigger="load, every 5s" hx-swap="innerHTML" aria-live="polite">
            @include('partials/engine-status')
        </div>
        <div id="app-update" hx-get="/app/update" hx-trigger="load, every 60s" hx-swap="innerHTML" aria-live="polite"></div>
        <button type="button" class="ae-key ae-key--square" x-data="ThemeToggle" @click="cycle()" :aria-label="label" :title="label">
            <span x-show="theme === 'dark'">{{{ icon('moon') }}}</span>
            <span x-show="theme === 'light'" x-cloak>{{{ icon('sun') }}}</span>
            <span x-show="theme === 'system'" x-cloak>{{{ icon('eye') }}}</span>
        </button>
        {{-- Optional bloop account: Sign in, or the account chip with its menu (partials/account-menu). --}}
        <div id="account-menu" class="topbar__account" hx-get="/account?refresh=0&from=menu" hx-trigger="load" hx-swap="innerHTML"></div>
    </header>

    <main id="main" class="page">
        {{{ await $slots.main() }}}
    </main>

    <div id="modal"></div>
</body>
</html>
