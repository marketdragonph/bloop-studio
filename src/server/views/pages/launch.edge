{{-- The launch screen: shown when the app opens, until the person signs in to bloop or continues
     without an account (routes/home.js). The bloop sign-in is optional; the app is free without it. --}}
@component('layouts/app', { title: 'Welcome', bodyClass: 'is-launch' })
{{-- Full-screen art behind everything; the content sits on its dark left side. Decorative only. --}}
<div class="launch-art" x-data="LaunchArt" aria-hidden="true">
  <img class="launch-art__img" src="/assets/img/launch-hangar.jpg" alt="" width="2560" height="1437" decoding="async" fetchpriority="high">
</div>
<div class="launch">
  <header class="launch__hero">
    <img class="launch__mark" src="/assets/img/bloop-studio-mark.svg" alt="" width="96" height="96">
    <div class="launch__intro">
      <p class="ae-stencil ae-stencil--sensor">Welcome to</p>
      <h1 class="launch__title">Bloop Studio</h1>
      <p class="ae-stencil launch__byline">by MarketDragon</p>
      <p class="launch__tagline">Lay out a story as cards. Render stills and video with sound on your own GPU.</p>
      <div class="launch__engine" data-engine-light hx-get="/engine/status" hx-trigger="load, every 5s" hx-swap="innerHTML" aria-live="polite">
        @include('partials/engine-status')
      </div>
    </div>
  </header>

  <div class="launch__choices">
    <section class="ae-plate launch__choice launch__choice--bloop" aria-labelledby="launch-bloop-h">
      <div class="ae-plate__inner launch__choice-inner">
        <p class="ae-stencil launch__kicker">Recommended · optional</p>
        <h2 id="launch-bloop-h" class="launch__choice-title">Sign in with bloop</h2>
        <ul class="launch__perks" role="list">
          <li>{{{ icon('bolt') }}}<span>Cloud models on every card: Kling, Seedance, Runway, Grok Imagine and more</span></li>
          <li>{{{ icon('check') }}}<span>New accounts get <strong>60 free credits</strong></span></li>
          <li>{{{ icon('key') }}}<span>Google, TikTok, Facebook or email. Your password never touches this app</span></li>
        </ul>
        <div id="bloop-account" class="launch__account" hx-get="/account?from=launch" hx-trigger="load" hx-swap="innerHTML" aria-live="polite">
          <p class="plate-note">Checking for a bloop sign-in…</p>
        </div>
      </div>
    </section>

    <section class="ae-plate launch__choice" aria-labelledby="launch-local-h">
      <div class="ae-plate__inner launch__choice-inner">
        <p class="ae-stencil launch__kicker">Free · offline</p>
        <h2 id="launch-local-h" class="launch__choice-title">Continue without an account</h2>
        <ul class="launch__perks" role="list">
          <li>{{{ icon('board') }}}<span>Everything renders on this PC through ComfyUI</span></li>
          <li>{{{ icon('settings') }}}<span>Sign in any time later from the top bar</span></li>
        </ul>
        <button type="button" class="ae-key ae-key--block" hx-post="/launch/continue">Continue without an account</button>
      </div>
    </section>
  </div>

  @if(recent.length)
    <section class="launch__recent" aria-labelledby="launch-recent-h">
      <h2 id="launch-recent-h" class="ae-stencil">Jump back in</h2>
      <ul class="tile-grid" role="list">
        @each(space in recent)
          <li>
            {{-- Opening a board also counts as continuing: the launch screen will not show again. --}}
            <a class="ae-plate tile" href="/spaces/{{ space.id }}" hx-post="/launch/continue" hx-vals='{"to": "/spaces/{{ space.id }}"}'>
              <span class="ae-plate__inner tile__inner">
                <span class="tile__name">{{ space.name }}</span>
                <span class="ae-readout">{{ space.node_count }} {{ space.node_count === 1 ? 'card' : 'cards' }}</span>
              </span>
            </a>
          </li>
        @end
      </ul>
    </section>
  @end
</div>
@end
