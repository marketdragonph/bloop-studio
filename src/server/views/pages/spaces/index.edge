@component('layouts/app', { title: 'Spaces' })
<div class="stack">
  <header class="page-head page-head--row">
    <div>
      <p class="ae-stencil ae-stencil--sensor">Bloop Studio</p>
      <h1 class="page-head__title">Spaces</h1>
    </div>
    <button class="ae-key ae-key--accent" hx-get="/spaces/create" hx-target="#modal" hx-swap="innerHTML">New space</button>
  </header>

  @if(spaces.length)
    <ul class="tile-grid" role="list">
      @each(space in spaces)
        <li>
          @!component('components/space-tile', { space, launch: false })
        </li>
      @end
    </ul>
  @else
    <div class="empty-bay">
      <p class="ae-stencil">Empty bay</p>
      <p class="plate-note">No spaces yet. Create one to start wiring cards, or start from a ready plan.</p>
      <button class="ae-key" hx-get="/spaces/starters" hx-target="#modal" hx-swap="innerHTML" data-control="board.starter">{{{ icon('wand') }}}<span>{{ controlLabel('board.starter') }}</span></button>
    </div>
  @end
</div>
@end
