{{-- View full screen / download, over any card media that exists. Shown on hover and keyboard focus. --}}
<div class="media-actions" x-show="hasMedia(node)">
  <button type="button" class="ae-key ae-key--sm ae-key--square ae-key--overlay" @click.stop="openViewer(node)"
          aria-label="View full screen" title="View full screen (or double-click)">{{{ icon('eye') }}}</button>
  <a class="ae-key ae-key--sm ae-key--square ae-key--overlay" :href="downloadUrl(node)" download @click.stop
     aria-label="Download original" title="Download original">{{{ icon('download') }}}</a>
</div>
