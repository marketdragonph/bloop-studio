{{-- Body of an Image, Video or Audio card: preview (with the loader while it renders), model + seed, Generate.
     No prompt box: its words come only from Text cards wired into the Words socket. --}}
<div class="card__render">
  <div class="card__media" :style="{ aspectRatio: previewAspect(node) }" @dblclick="openViewer(node)">
    @include('pages/spaces/media-actions')
    <template x-if="mediaUrl(node) && node.type === 'image'">
      <img :src="mediaUrl(node)" alt="" loading="lazy" @load="noteMediaShape(node, $el)">
    </template>
    <template x-if="mediaUrl(node) && node.type === 'video'">
      @include('pages/spaces/media-video')
    </template>
    <template x-if="mediaUrl(node) && node.type === 'audio'">
      @include('pages/spaces/media-audio')
    </template>
    @include('pages/spaces/card-loader')
    <template x-if="!mediaUrl(node) && !isBusy(node)">
      <span class="ae-readout card__placeholder"
            x-text="node.type === 'audio' && !families.audio?.length ? 'Sign in to bloop for voices, sound and music' : hasWords(node) ? 'Press Generate to make it' : 'Wire a Text card into Words'"></span>
    </template>
  </div>

  <div class="card__knobs">
    <div class="card__knob card__knob--wide">
      @!component('components/select', {
        label: 'Model',
        options: "families[node.type].map(f => ({ value: f.id, label: f.label, description: f.description }))",
        value: 'familyOf(node)',
        change: 'setFamily(node, v)',
        disabled: 'isBusy(node)'
      })
    </div>
    {{-- A bloop cloud model offers only the knobs it takes; an empty list hides that knob. --}}
    <template x-if="knobsFor(node).aspects.length">
      <div class="card__knob">
        @!component('components/select', {
          label: 'Aspect', options: 'knobsFor(node).aspects', value: "knobValue(node, 'aspect')",
          change: "setKnob(node, 'aspect', v)", disabled: 'isBusy(node)'
        })
      </div>
    </template>
    <template x-if="knobsFor(node).resolutions.length">
      <div class="card__knob">
        @!component('components/select', {
          label: 'Resolution', options: 'knobsFor(node).resolutions', value: "knobValue(node, 'resolution')",
          change: "setKnob(node, 'resolution', v)", disabled: 'isBusy(node)'
        })
      </div>
    </template>
    <template x-if="knobsFor(node).durations.length">
      <div class="card__knob">
        @!component('components/select', {
          label: 'Duration', options: 'knobsFor(node).durations', value: "knobValue(node, 'duration')",
          change: "setKnob(node, 'duration', v)", disabled: 'isBusy(node)'
        })
      </div>
    </template>
    {{-- A bloop voice model's voices (ElevenLabs `voice`, MiniMax `voice_id`, Qwen `speaker`). --}}
    <template x-if="knobsFor(node).voices.length">
      <div class="card__knob card__knob--wide">
        @!component('components/select', {
          label: 'Voice', options: 'knobsFor(node).voices', value: "knobValue(node, 'voice')",
          change: "setKnob(node, 'voice', v)", disabled: 'isBusy(node)'
        })
      </div>
    </template>
    <template x-if="knobsFor(node).qualities.length > 1">
      <div class="card__knob">
        @!component('components/select', {
          label: 'Quality', options: 'knobsFor(node).qualities', value: "knobValue(node, 'quality')",
          change: "setKnob(node, 'quality', v)", disabled: 'isBusy(node)'
        })
      </div>
    </template>
  </div>

  <div class="card__controls" x-show="node.type !== 'audio'">
    <button type="button" class="ae-key ae-key--sm" @click="toggleSeedLock(node)" :aria-pressed="!!node.settings?.seedLocked"
            :title="node.settings?.seed != null ? 'Seed ' + node.settings.seed : 'No seed yet'">
      <span x-show="node.settings?.seedLocked">{{{ icon('lock') }}}</span>
      <span x-text="node.settings?.seedLocked ? 'Seed locked' : 'Seed: new'"></span>
    </button>
  </div>

  <p class="field__error" x-show="node.status === 'failed' && node.error" x-text="node.error"></p>

  <button type="button" class="ae-key ae-key--accent ae-key--block" x-show="!isBusy(node)" @click="generate(node)">{{{ icon('bolt') }}}<span>Generate</span></button>
  <button type="button" class="ae-key ae-key--block" x-show="isBusy(node)" @click="cancelRender(node)">{{{ icon('close') }}}<span>Cancel</span></button>
</div>
