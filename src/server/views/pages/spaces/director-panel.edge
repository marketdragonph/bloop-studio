{{-- The Space Director: a chat that builds the board. It never renders; Generate stays with the person. --}}
<aside class="director" id="director-panel" x-show="directorOpen" x-cloak aria-label="Director">
  <header class="director__head">
    <span class="ae-stencil ae-stencil--sensor">{{{ icon('chat') }}} Director</span>
    <span class="status-light status-light--busy director__state" x-show="directorBusy" role="status">
      <span class="status-light__dot ae-sensor-dot" aria-hidden="true"></span><span class="ae-readout">Working</span>
    </span>
    <button type="button" class="ae-key ae-key--sm" @click="clearDirector()" :disabled="directorBusy || !directorLog.length" title="Clear conversation">{{{ icon('delete') }}}</button>
    <button type="button" class="ae-key ae-key--sm ae-key--square" @click="directorOpen = false" aria-label="Close Director">{{{ icon('close') }}}</button>
  </header>

  <div class="director__log scrolls" x-ref="directorLog" aria-live="polite">
    <template x-if="!directorLog.length">
      <div class="director__empty">
        {{-- bloop's empty state: the brief, then example asks that fill the box (they never send on their own). --}}
        <p class="ae-stencil">Mission brief</p>
        <p class="director__lead">Tell the Director the film you want. It plans the shots for you.</p>
        <p class="plate-note">It plans first and asks a question or two, then lays out the cast, the places and every shot, wired. Nothing renders until you say so. It also knows this app: ask it how anything here works.</p>
        <div class="director__seeds">
          <template x-for="(seed, i) in directorSeeds" :key="i">
            <button type="button" class="director__seed" @click="fillDirector(seed)">
              <span class="ae-readout" x-text="String(i + 1).padStart(2, '0')"></span><span x-text="seed"></span>
            </button>
          </template>
        </div>
      </div>
    </template>
    <template x-for="entry in directorLog" :key="entry.id">
      <div class="director__msg" :class="'director__msg--' + entry.role">
        <p class="ae-readout" x-show="entry.info" x-text="entry.info"></p>
        {{-- The Director's words as markdown (escaped first: board/markdown.js); the person's as typed. --}}
        <div class="director__text director__md" x-show="entry.text && entry.role === 'assistant'" x-html="entry.role === 'assistant' ? markdown(entry.text) : ''"></div>
        <p class="director__text" x-show="entry.text && entry.role !== 'assistant'" x-text="entry.text"></p>
        {{-- While it works: what it is doing right now, and what has landed so far. --}}
        <p class="director__working" x-show="entry.streaming" role="status">
          <svg class="beat-line director__beat" viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <polyline class="beat-line__track" points="0,10 14,10 17,7 20,10 26,10 28,13 31,2 34,17 36,10 42,10 46,6 50,10 60,10 74,10 77,7 80,10 86,10 88,13 91,2 94,17 96,10 102,10 106,6 110,10 120,10" />
            <polyline class="beat-line__pulse" pathLength="100" points="0,10 14,10 17,7 20,10 26,10 28,13 31,2 34,17 36,10 42,10 46,6 50,10 60,10 74,10 77,7 80,10 86,10 88,13 91,2 94,17 96,10 102,10 106,6 110,10 120,10" />
          </svg>
          <span class="ae-readout" x-text="workingLabel(entry)"></span>
        </p>
        <p class="ae-readout director__actions" x-show="entry.actions?.length && !entry.streaming" x-text="actionSummary(entry.actions || [])"></p>
        <p class="field__error" x-show="entry.notice" x-text="entry.notice"></p>
      </div>
    </template>
  </div>

  {{-- The beats being written (bloop's build block): one row per lane, its state by weight, amber only on a failure. --}}
  <section class="director__build" x-show="directorBuild && directorBuild.total" aria-label="Build">
    <p class="ae-readout director__build-head" role="status">
      <span class="ae-sensor-dot" x-show="directorBuild?.building" aria-hidden="true"></span>
      <span x-text="buildReadout(directorBuild)"></span>
    </p>
    <ol class="director__lanes" x-show="directorBuild?.building || directorBuild?.failed">
      <template x-for="lane in (directorBuild?.lanes || [])" :key="lane.tag">
        <li class="director__lane" :class="'is-' + lane.state">
          <span class="director__lane-tag" x-text="lane.tag"></span>
          <span class="director__lane-note" x-show="lane.state === 'failed'" x-text="lane.error"></span>
          <span class="director__lane-note" x-show="lane.state === 'queued' || lane.state === 'writing'" x-text="lane.brief"></span>
        </li>
      </template>
    </ol>
  </section>

  <form class="director__compose" @submit.prevent="sendDirector()">
    <textarea class="card__text card__text--grow" x-ref="directorInput" rows="2" x-model="directorInput"
              placeholder="Describe what to build…" aria-label="Message to the Director"
              @keydown="onDirectorKey($event)" :disabled="directorBusy"></textarea>
    <div class="row row--end">
      <button type="button" class="ae-key" x-show="directorBusy" @click="stopDirector()">{{{ icon('close') }}}<span>Stop</span></button>
      <button type="submit" class="ae-key ae-key--accent" x-show="!directorBusy" :disabled="!directorInput.trim()">{{{ icon('wand') }}}<span>Send</span></button>
    </div>
  </form>
</aside>
