{{-- The selected clip's details under the preview: what it is, its in and out, and every edit as a key, so
     touch and keyboard reach the same actions as the mouse (Move left / Move right instead of a drag).
     P5: on a narrow window this is the item sheet (cut-narrow.css): Trim has a slider for each end over the whole
     clip and −0.1 s / +0.1 s keys, so a trim never needs the small handles; Done closes it. --}}
<div class="cut-details" x-show="cutSelected()" x-cloak :class="{ 'is-item-open': cutItemOpen }" role="group" aria-label="Selected clip">
  <button type="button" class="ae-key ae-key--sm cut-details__done" @click="cutCloseItem()" data-control="cut.closeItem">{{ controlLabel('cut.closeItem') }}</button>
  <dl class="cut-preview__meta">
    <div class="cut-preview__row"><dt>Selected</dt><dd x-text="cutSelected()?.title"></dd></div>
    <div class="cut-preview__row"><dt>Length</dt><dd x-text="cutSelected() ? cutLength(cutSelected()) + (cutSelected().measured === false ? ' · not measured' : '') : ''"></dd></div>
    <div class="cut-preview__row" x-show="cutSelected()?.ready"><dt>In / out</dt>
      <dd x-text="cutSelected()?.ready ? cutTenths(cutSelected().in_ms) + ' – ' + cutTenths(cutSelected().out_ms) : ''"></dd></div>
  </dl>
  <p class="cut-details__note" x-show="cutSelected()?.note"><span class="cut-note__dot" aria-hidden="true"></span><span x-text="cutSelected()?.note"></span></p>
  <p class="cut-details__why" x-show="cutTurnWhy(cutSelected())" x-text="cutTurnWhy(cutSelected())"></p>
  <p class="cut-details__alert" x-show="cutSelected()?.gone" x-text="cutStateText({ state: 'deleted' })"></p>
  <p class="cut-details__alert" x-show="cutUnplayable.includes(cutSelected()?.key)">
    <span x-text="cutCopy('unplayable')"></span>
    <button type="button" class="ae-key ae-key--sm" x-show="cutSelected() && cutCanGo(cutSelected())" @click="cutGoToCard(cutSelected())"
            data-control="cut.goToCard">{{ controlLabel('cut.goToCard') }}</button>
  </p>
  <div class="cut-trim" role="group" aria-label="{{ controlLabel('cut.trimSheet') }}" x-show="cutEditable()" data-control="cut.trimSheet">
    <template x-for="edge in ['in', 'out']" :key="edge">
      <div class="cut-trim__row">
        <span class="ae-readout cut-trim__label" x-text="cutTrimText(edge)"></span>
        <button type="button" class="ae-key ae-key--sm" @click="cutTrimStep(edge, -1)" data-control="cut.nudgeBack"
                :aria-label="(edge === 'in' ? 'In' : 'Out') + ' {{ controlLabel('cut.nudgeBack') }}'">{{ controlLabel('cut.nudgeBack') }}</button>
        <input type="range" class="cut-trim__range" min="0" step="100" :max="cutTrimBounds().max"
               :value="edge === 'in' ? cutTrimBounds().in_ms : cutTrimBounds().out_ms"
               :aria-label="'{{ controlLabel('cut.trimSheet') }} ' + (edge === 'in' ? 'in' : 'out')" :aria-valuetext="cutTrimText(edge)"
               @input="cutTrimRange(edge, $event.target.value)" @change="cutTrimRange(edge, $event.target.value, { commit: true })">
        <button type="button" class="ae-key ae-key--sm" @click="cutTrimStep(edge, 1)" data-control="cut.nudgeOn"
                :aria-label="(edge === 'in' ? 'In' : 'Out') + ' {{ controlLabel('cut.nudgeOn') }}'">{{ controlLabel('cut.nudgeOn') }}</button>
      </div>
    </template>
  </div>
  <div class="cut-details__keys" role="group" aria-label="Edits" x-show="cutEditable()">
    <button type="button" class="ae-key ae-key--sm" @click="cutMove(-1)" :disabled="!cutCanMove(-1)"
            data-control="cut.moveLeft" aria-keyshortcuts="Alt+ArrowLeft">{{ controlLabel('cut.moveLeft') }}</button>
    <button type="button" class="ae-key ae-key--sm" @click="cutMove(1)" :disabled="!cutCanMove(1)"
            data-control="cut.moveRight" aria-keyshortcuts="Alt+ArrowRight">{{ controlLabel('cut.moveRight') }}</button>
    <button type="button" class="ae-key ae-key--sm" @click="cutSplit(true)" :aria-disabled="cutSplitPlan(cutPlayheadMs, true).refused ? 'true' : 'false'" :title="cutSplitTitle(true)"
            data-control="cut.split" aria-keyshortcuts="Control+B Meta+B S">{{{ icon('split') }}}<span>{{ controlLabel('cut.split') }}</span></button>
    <button type="button" class="ae-key ae-key--sm" @click="cutEdgeAtPlayhead('in')" data-control="cut.inPoint" aria-keyshortcuts="[">{{ controlLabel('cut.inPoint') }}</button>
    <button type="button" class="ae-key ae-key--sm" @click="cutEdgeAtPlayhead('out')" data-control="cut.outPoint" aria-keyshortcuts="]">{{ controlLabel('cut.outPoint') }}</button>
    <button type="button" class="ae-key ae-key--sm" @click="cutToggleSound()" :aria-pressed="cutEditable()?.sound ? 'true' : 'false'"
            data-control="cut.mute" aria-keyshortcuts="M">{{{ icon('volume') }}}<span>{{ controlLabel('cut.mute') }}</span></button>
    <button type="button" class="ae-key ae-key--sm" @click="cutUseNewTake(cutEditable())" x-show="cutEditable()?.newTake"
            data-control="cut.useNewTake">{{ controlLabel('cut.useNewTake') }}</button>
    <button type="button" class="ae-key ae-key--sm" @click="cutSetPoster()" :aria-pressed="cutPosterAt(cutEditable()) ? 'true' : 'false'"
            data-control="cut.poster">{{{ icon('poster') }}}<span>{{ controlLabel('cut.poster') }}</span></button>
    <button type="button" class="ae-key ae-key--sm" @click="cutRemove()" data-control="cut.remove" aria-keyshortcuts="Delete">{{{ icon('delete') }}}<span>{{ controlLabel('cut.remove') }}</span></button>
  </div>
</div>
