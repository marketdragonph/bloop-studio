{{-- Ruler, Video / Voice / Music lanes and the playhead (02-dock.md §4). With gaps (default) every slot shows at
     its length; As exported hides them. Beds play in export time, so their lanes pause (hatched) under each gap.
     Positions are CSS variables from the shared time map; the lanes scroll sideways together past Fit. Drag on
     the ruler to move the playhead; the player moves it by one CSS variable (--cut-x). P4: the corner holds Snap to
     beats; the ruler's sensor-blue ticks are the bed's measured beats (downbeats taller, labelled estimated) and
     the alert marks are timed Check your cut lines; the Voice lane shows measured spoken lines and the Music lane
     its duck bands (dashed top), all from the server's numbers. --}}
<div class="cut-tracks">
  <div class="cut-tracks__labels">
    {{-- Icons, not words (owner, 2026-10-06): each lane is its glyph, its name in the tooltip and for screen readers.
         Snap to beats is the magnet key; "Beats · estimated" / "Not measured" ride on the Music glyph's tooltip, and a
         sensor dot marks the Music lane while it has not been measured. --}}
    <div class="cut-tracks__corner">
      <button type="button" class="cut-snap" @click="cutSnapToggle()" :aria-pressed="cutSnap ? 'true' : 'false'"
              :disabled="!cutSnapReady() && !cutSnap" data-control="cut.snap" :title="'{{ controlLabel('cut.snap') }} · ' + cutBeatsLabel()"
              :aria-label="'{{ controlLabel('cut.snap') }}, ' + cutBeatsLabel()">{{{ icon('magnet') }}}</button>
    </div>
    <div class="cut-track-label cut-track-label--video" title="{{ controlLabel('cut.lane.video') }} · one clip per beat">
      <span class="cut-track-label__icon" data-control="cut.lane.video">{{{ icon('video') }}}<span class="visually-hidden">{{ controlLabel('cut.lane.video') }}</span></span>
    </div>
    <div class="cut-track-label cut-track-label--voice" x-show="cutBeds.voice || cutSpeechSpans.length"
         :title="cutBeds.voice ? '{{ controlLabel('cut.lane.voice') }}' : '{{ controlLabel('cut.lane.voice') }} · in the clips'">
      <span class="cut-track-label__icon" data-control="cut.lane.voice">{{{ icon('voice') }}}<span class="visually-hidden">{{ controlLabel('cut.lane.voice') }}</span></span>
      <span class="visually-hidden" x-show="!cutBeds.voice">In clips</span>
      <template x-if="cutBeds.voice">
        @!component('pages/spaces/cut/level', { kind: 'voice', name: 'Voice' })
      </template>
    </div>
    <div class="cut-track-label cut-track-label--music" :title="'{{ controlLabel('cut.lane.music') }}' + (cutBeatsShort() ? ' · ' + cutBeatsShort() : '')">
      <span class="cut-track-label__icon" data-control="cut.lane.music">{{{ icon('music') }}}<span class="visually-hidden">{{ controlLabel('cut.lane.music') }}</span>
        <span class="cut-track-label__dot" x-show="cutToolsMissing()" x-cloak aria-hidden="true"></span></span>
      <template x-if="cutBeds.music">
        @!component('pages/spaces/cut/level', { kind: 'music', name: 'Music' })
      </template>
      <span class="visually-hidden cut-track-label__beats" x-show="cutBeatsShort()" x-text="cutBeatsShort()"></span>
    </div>
  </div>

  <div class="cut-tracks__scroll" data-cut-part="scroll" data-control="cut.zoom" @wheel="cutWheel($event)" @scroll.passive="cutOnScroll()">
    <div class="cut-tracks__span" data-cut-part="span" :style="{ '--cut-span': cutSpan + 'px' }">
      <div class="cut-ruler" aria-hidden="true" @pointerdown="cutScrubStart($event)" :class="{ 'has-minors': cutMinors.length > 0 }" :style="{ '--cut-tick-step': cutTickStep > 1 ? cutTickStep + 'px' : '100%' }">
        <template x-for="tick in cutTicks" :key="tick.key">
          <span class="cut-ruler__tick is-major" :style="{ '--x': tick.x + 'px' }"><span class="cut-ruler__label" x-text="tick.label"></span></span>
        </template>
        <template x-for="tick in cutMinors" :key="tick.key">
          <span class="cut-ruler__tick" :style="{ '--x': tick.x + 'px' }"></span>
        </template>
        <template x-for="beat in cutBeats" :key="beat.key">
          <span class="cut-ruler__beat" :class="{ 'is-down': beat.down }" :style="{ '--x': beat.x + 'px' }"></span>
        </template>
        <template x-for="check in cutChecks().filter((c) => c.at_ms != null)" :key="check.key">
          <span class="cut-ruler__check" :style="{ '--x': cutCheckX(check) + 'px' }" :title="check.time + ' ' + check.text"></span>
        </template>
      </div>

      <ol class="cut-lane cut-lane--video" aria-label="Video lane">
        <template x-for="item in cutItems" :key="item.key">
          @include('pages/spaces/cut/item')
        </template>
      </ol>

      <div class="cut-lane cut-lane--voice" x-show="cutBeds.voice || cutSpeechSpans.length" aria-label="Voice lane" role="group">
        <template x-for="span in cutSpeechSpans" :key="span.key">
          <span class="cut-speech" :style="{ '--x': span.x + 'px', '--w': span.w + 'px' }" x-text="cutSpeechLabel(span)"></span>
        </template>
        <template x-for="span in cutVoice" :key="span.key">
          <span class="cut-voice" :style="{ '--x': span.x + 'px', '--w': span.w + 'px' }" x-text="cutBeds.voice?.label"></span>
        </template>
        <template x-for="pause in cutPauses" :key="pause.key">
          <span class="cut-pause" :style="{ '--x': pause.x + 'px', '--w': pause.w + 'px' }"></span>
        </template>
      </div>

      <div class="cut-lane cut-lane--music" aria-label="Music lane" role="group">
        <template x-if="cutBeds.music">
          <div class="cut-music">
            <template x-for="segment in cutMusic" :key="segment.key">
              <span class="cut-music__segment" :style="{ '--x': segment.x + 'px', '--w': segment.w + 'px' }">
                <svg class="cut-wave" x-show="cutWave" :view-box.camel="cutWaveBox(segment)" preserveAspectRatio="none" focusable="false" aria-hidden="true"><path :d="cutWave"></path></svg>
                <span class="cut-music__flat" x-show="!cutWave" aria-hidden="true"></span>
              </span>
            </template>
            <template x-for="pause in cutPauses" :key="pause.key">
              <span class="cut-pause" :style="{ '--x': pause.x + 'px', '--w': pause.w + 'px' }"></span>
            </template>
            <template x-for="band in cutDuckBands" :key="band.key">
              <span class="cut-duck" :style="{ '--x': band.x + 'px', '--w': band.w + 'px' }"></span>
            </template>
            <span class="cut-lane__measure" x-show="cutToolsMissing()" x-text="cutCopy('laneNotMeasured')"></span>
            <span class="visually-hidden" x-text="cutBeds.music.label + (cutDuckBands.length ? ', ' + cutDuckText() : '')"></span>
          </div>
        </template>
        <p class="cut-lane__note" x-show="!cutBeds.music && !cutOffered.music" x-text="cutEmptyText.music"></p>
        <p class="cut-lane__note cut-lane__offer" x-show="!cutBeds.music && cutOffered.music">
          <span x-text="cutCopy('musicOffered', { label: cutOffered.music?.label ?? '' })"></span>
          <button type="button" class="ae-key ae-key--sm" data-control="cut.useMusic" @click="cutUseBed('music')">{{ controlLabel('cut.useMusic') }}</button>
        </p>
      </div>

      <div class="cut-playhead" data-cut-part="playhead" aria-hidden="true"><span class="cut-playhead__cap" data-cut-part="cap">0:00</span></div>
    </div>
  </div>
</div>
