{{-- One card on the board (rendered by Alpine x-for; `node` is the loop variable).
     The article is unclipped so its round sockets can sit on the edge; the cut plate is .card__plate. --}}
<article class="card" :data-node-id="node.id" tabindex="0"
         :class="{ ['card--' + node.type]: true, 'is-selected': isSelected(node), 'is-live': node.status === 'generating' || node.status === 'queued' }"
         :style="{ left: node.position_x + 'px', top: node.position_y + 'px', width: (node.width || 280) + 'px' }"
         :aria-label="typeLabel(node) + ' card'"
         @pointerdown="selectCard($event, node)" @pointerup="finishWire($event, node)">

  <template x-for="(socket, i) in socketsOf(node)" :key="socket.key">
    <span class="port port--in" :style="{ top: socketTop(i) + 'px' }" :data-socket="socket.key"
          :class="{ ['is-' + socketState(node, socket)]: socketState(node, socket), 'is-connected': isSocketConnected(node, socket) }"
          :title="socket.label + ' · takes ' + socket.accepts.join(' or ')"
          @pointerup="finishWire($event, node, socket.key)">
      <span class="port__glyph" x-html="iconSvg(socket.icon)"></span>
      <span class="port__glyph port__glyph--drop">{{{ icon('plus') }}}</span>
    </span>
  </template>
  <button type="button" class="port port--out" @pointerdown="startWire($event, node)"
          :aria-label="'Wire from this ' + typeLabel(node) + ' card'" :title="'Drag to wire this ' + typeLabel(node) + ' card'">
    <span class="port__glyph">{{{ icon('arrow') }}}</span>
  </button>

  <div class="card__plate">
    <header class="card__head">
      <span class="ae-stencil card__title"><span class="card__icon" x-html="iconSvg(nodeTypes[node.type]?.icon)"></span><span x-text="node.label || typeLabel(node)" :title="node.label ? typeLabel(node) + ' · ' + node.label : ''"></span></span>
      <span class="card__status ae-readout" x-show="node.status !== 'idle'" x-text="node.status"></span>
      <button type="button" class="card__close" @click="removeCard(node.id)" aria-label="Delete card" title="Delete card">{{{ icon('close') }}}</button>
    </header>

    <div class="card__body">
      <template x-if="node.type === 'text' || node.type === 'note'">
        <textarea class="card__text card__text--grow scrolls" rows="3" :placeholder="node.type === 'note' ? 'A note for yourself…' : 'Describe the shot, the character, the idea…'"
                  :value="node.text_content ?? ''" @input="editText(node, 'text_content', $event.target.value)"></textarea>
      </template>

      <template x-if="node.type === 'image' || node.type === 'video' || node.type === 'audio'">
        @include('pages/spaces/card-render')
      </template>

      <template x-if="node.type === 'upload'">
        {{-- `for` ties the label to the file input: without it a label clicks its FIRST control, which is
             the hidden "View full screen" key in media-actions, so clicking the drop area did nothing. --}}
        <label class="card__drop" :class="{ 'has-media': mediaUrl(node) }" :for="'upload-file-' + node.id"
               @dragover.prevent @drop="onUploadDrop($event, node)" @dblclick.prevent="openViewer(node)">
          @include('pages/spaces/media-actions')
          <input type="file" class="visually-hidden" :id="'upload-file-' + node.id" accept="image/png,image/jpeg,image/webp,video/mp4,video/webm,audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/flac,audio/mp4"
                 @change="uploadFile(node, $event.target.files[0]); $event.target.value = ''">
          <template x-if="mediaUrl(node) && !isVideo(node) && !isAudio(node)">
            <img :src="mediaUrl(node)" :alt="node.label || 'Uploaded picture'">
          </template>
          <template x-if="mediaUrl(node) && isAudio(node)">
            @include('pages/spaces/media-audio')
          </template>
          <template x-if="mediaUrl(node) && isVideo(node)">
            @include('pages/spaces/media-video')
          </template>
          <span class="card__drop-hint" x-show="!mediaUrl(node)">
            {{{ icon('upload') }}}<span x-text="node.status === 'generating' ? 'Uploading…' : 'Drop a picture, clip or voice, or click to choose'"></span>
          </span>
        </label>
        <p class="ae-readout card__filename" x-show="node.label" x-text="node.label"></p>
      </template>
    </div>
  </div>
</article>
